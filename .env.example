ANTHROPIC_API_KEY=sk-ant-your-key-here

# API key propia de Norte-kpi para autenticar herramientas externas que
# llamen a /api/kpi-estimate y /api/kpi-evaluate. No confundir con la de
# arriba: esta nunca se usa para llamar a Anthropic. Generar un valor
# random (ej. `openssl rand -hex 32`), no dejar el placeholder en producción.
NORTE_API_KEY=norte-your-own-random-key-here
