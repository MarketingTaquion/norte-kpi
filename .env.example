# API key propia de Norte-kpi para autenticar herramientas externas que
# llamen a /api/kpi-estimate y /api/kpi-evaluate desde afuera. No hace falta
# para usar el wizard ni el Evaluador en el browser — esos calculan todo
# localmente, sin llamar a ninguna API externa ni necesitar ninguna otra key.
# Generar un valor random (ej. `openssl rand -hex 32`), no dejar el
# placeholder en producción.
NORTE_API_KEY=norte-your-own-random-key-here
